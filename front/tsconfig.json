{
	"extends": "@elyspio/vite-eslint-config/tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"paths": {
			"@/*": ["./src/*"],
			"@apis/*": ["./src/core/apis/*"],
			"@services/*": ["./src/core/services/*"],
			"@data/*": ["./src/core/data/*"],
			"@components/*": ["./src/view/components/*"],
			"@hooks/*": ["./src/view/hooks/*"],
			"@pages/*": ["./src/view/pages/*"]
		},
		"types": ["vite-plus/client"]
	},
	"include": ["src", "tests", "vite.config.ts", "scripts"]
}
