{
	"ConnectionStrings": {
		"MongoDb": "{ReplacedByAspire}"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Debug",
			"Override": {
				"System": "Warning",
				"Microsoft": "Debug",
				"Hangfire": "Warning",
				"ZiggyCreatures.Caching.Fusion.FusionCache": "Warning"
			}
		}
	},
	"Oidc": {
		"ValidateIssuer": true,
		"ValidateLifetime": true,
		"ClockSkew": 10
	}
}